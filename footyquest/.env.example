# SQLite database (relative to the prisma/ folder)
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies — set a long random string in production
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional: enables true AI plan generation. Without it, the built-in
# evidence-based rules engine generates plans instead.
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"
